---
import Base from '../layouts/Base.astro';
import KineticWordmark from '../components/KineticWordmark.astro';
import ClientLogo from '../components/ClientLogo.astro';
import InkWord from '../components/InkWord.astro';
import BrandFilm from '../components/BrandFilm.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import SiteCheck from '../components/SiteCheck.astro';
import AboutSection from '../components/AboutSection.astro';
import { site } from '../data/site';
import { services, addons, details, process } from '../data/services';
import { projects } from '../data/work';
import { hl } from '../utils/text';

const pad = (n: number) => String(n).padStart(2, '0');

// The other 99% vs the one percent, line for line.
const compare = [
  ['A template thousands of other businesses are using', 'Designed from scratch around your business'],
  ['Stock photos of strangers shaking hands', 'Your real people, places and products'],
  ['Copy that could belong to anyone', 'Words written in your voice'],
  ['Looks dated a year after launch', 'Built to be updated, so it stays fresh'],
  ['Breaks on the screens nobody checked', 'Tested on every screen, phone to TV'],
];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <p class="label">{site.kind}</p>
      <KineticWordmark hero />
      <div class="hero__foot">
        <h1 class="hero__title" data-reveal>
          <span class="hero__line">99% of websites blend in.</span>
          <span class="hero__line">Be the <InkWord mark="swoosh">one percent</InkWord> that stands out.</span>
        </h1>
        <div class="hero__side" data-reveal style="--reveal-delay: 0.1s">
          <p class="hero__lede">
            Most websites are built from the same templates, filled with the same stock photos, and start to look
            dated the day they launch. We design brands, build websites and bring them to life with motion, so yours
            looks like nobody else’s and keeps looking good long after launch.
          </p>
          <div class="hero__actions">
            <a class="btn" href="#contact">Start a project <span class="btn__arrow" aria-hidden="true">→</span></a>
            <a class="btn btn--ghost" href="#work">See the work</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The other 99% -->
  <section class="ninety-nine" aria-labelledby="ninety-nine-title">
    <div class="wrap">
      <header class="section-head section-head--split">
        <div>
          <p class="label"><span class="label__num">01</span> The other 99%</p>
          <h2 id="ninety-nine-title" class="section-title" data-reveal>
            Same template. Same stock photos. Same <InkWord mark="strike">forgettable</InkWord> result.
          </h2>
        </div>
        <figure class="dots" data-reveal aria-hidden="true">
          <div class="dots__grid">
            {Array.from({ length: 100 }, (_, i) => <span class:list={['dots__dot', { 'dots__dot--one': i === 99 }]} />)}
          </div>
          <figcaption>99 look the same. 1 gets remembered.</figcaption>
        </figure>
      </header>

      <div class="compare" role="table" aria-label="The other 99% compared with the one percent">
        <div class="compare__row compare__row--head" role="row">
          <span role="columnheader">The other 99%</span>
          <span role="columnheader">The one percent</span>
        </div>
        {compare.map(([them, us]) => (
          <div class="compare__row" role="row" data-reveal>
            <span class="compare__them" role="cell">{them}</span>
            <span class="compare__us" role="cell">{us}</span>
          </div>
        ))}
      </div>
      <SiteCheck />
    </div>
  </section>

  <!-- Work -->
  <section class="work on-ink" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <header class="section-head">
        <p class="label"><span class="label__num">02</span> Selected work</p>
        <h2 id="work-title" class="section-title" data-reveal>Work we’re <InkWord mark="circle">proud</InkWord> of.</h2>
      </header>

      <ol class="work__list">
        {projects.map((p, i) => (
          <li class="work-item" data-reveal>
            <a class="work-item__media" href={`/work/${p.slug}`} tabindex="-1" aria-hidden="true">
              <ClientLogo id={p.logo} label={`${p.client} logo`} />
            </a>
            <div class="work-item__body">
              <p class="work-item__meta">
                <span>{pad(i + 1)}</span>
                <span>{p.sector}</span>
                <span>{p.location}</span>
                <span>{p.year}</span>
              </p>
              <h3 class="work-item__title" set:html={hl(p.client, p.accent)} />
              <p class="work-item__teaser">{p.teaser}</p>
              <ul class="tags">
                {p.services.map((s) => <li>{s}</li>)}
              </ul>
              <a class="btn btn--ghost" href={`/work/${p.slug}`}>
                Read the case study <span class="btn__arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Services -->
  <section class="services" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <header class="section-head section-head--split">
        <div>
          <p class="label"><span class="label__num">03</span> Services</p>
          <h2 id="services-title" class="section-title" data-reveal>What we <InkWord mark="double">make</InkWord>.</h2>
        </div>
        <p class="section-intro" data-reveal>
          Every project is quoted on its own scope. Tell us what you need and we’ll come back with a clear, fixed price
          before any work starts.
        </p>
      </header>

      <div class="services__grid">
        {services.map((s, i) => (
          <article class="service" data-reveal style={`--reveal-delay: ${(i % 2) * 0.08}s`}>
            <p class="service__num">{pad(i + 1)}</p>
            <h3 class="service__title" set:html={hl(s.title, s.accent)} />
            <p class="service__summary">{s.summary}</p>
            <ul class="service__list">
              {s.includes.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <div class="motion-film">
        <div class="motion-film__head" data-reveal>
          <p class="label">Motion graphics, in motion</p>
          <h3 class="motion-film__title">Our own brand, in <span class="serif">motion</span>.</h3>
          <p class="motion-film__intro">
            A 30-second brand film, coded to run live in your browser, so it’s sharp on any screen. The same piece cuts
            to music for social media.
          </p>
        </div>
        <BrandFilm />
      </div>

      <div class="addons">
        <div class="addons__head" data-reveal>
          <p class="label">Add-ons</p>
          <h3 class="addons__title">Smaller jobs, same <span class="serif">standards</span>.</h3>
          <p class="addons__intro">On their own, or alongside a bigger project.</p>
        </div>
        <ul class="addons__list">
          {addons.map((a) => (
            <li class="addon" data-reveal>
              <h4 class="addon__title">{a.title}</h4>
              <p class="addon__summary">{a.summary}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- The one percent -->
  <section class="details on-ink" aria-labelledby="details-title">
    <div class="wrap">
      <header class="section-head">
        <p class="label"><span class="label__num">04</span> The one percent</p>
        <h2 id="details-title" class="section-title" data-reveal>
          The details most studios <InkWord mark="zigzag">skip</InkWord>.
        </h2>
      </header>
      <ol class="details__grid">
        {details.map((d, i) => (
          <li class="detail" data-reveal style={`--reveal-delay: ${(i % 3) * 0.06}s`}>
            <span class="detail__pct" aria-hidden="true">1%</span>
            <h3 class="detail__title">{d.title}</h3>
            <p>{d.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Process -->
  <section class="process" id="process" aria-labelledby="process-title">
    <div class="wrap">
      <header class="section-head">
        <p class="label"><span class="label__num">05</span> Process</p>
        <h2 id="process-title" class="section-title" data-reveal>How a project <InkWord mark="swoosh">runs</InkWord>.</h2>
      </header>
      <ol class="process__steps">
        {process.map((step, i) => (
          <li class="step" data-reveal style={`--reveal-delay: ${i * 0.06}s`}>
            <p class="step__num">{pad(i + 1)}</p>
            <h3 class="step__title">{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- About -->
  <AboutSection />

  <!-- Contact -->
  <section class="contact on-ink" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <p class="label"><span class="label__num">07</span> Contact</p>
      <h2 id="contact-title" class="contact__title" data-reveal>
        Let’s build your <InkWord mark="double">one percent</InkWord>.
      </h2>

      <div class="contact__grid">
        <div class="contact__side" data-reveal>
          <p class="contact__lede">
            Tell us about your business and what you need. We read every enquiry ourselves and come back with a
            clear scope and a fixed quote.
          </p>
          <p class="contact__alt-label">Prefer email?</p>
          <a class="contact__email" href={`mailto:${site.contact.email}?subject=New%20project`}>
            {site.contact.email}
          </a>
          {site.contact.whatsapp && (
            <p class="contact__alt">
              Or WhatsApp us on <a href={site.contact.whatsapp}>{site.contact.whatsappLabel}</a>
            </p>
          )}
        </div>
        <EnquiryForm />
      </div>
    </div>
  </section>
</Base>

<style>
  section {
    padding-block: clamp(80px, 11vw, 168px);
  }

  .section-head {
    margin-bottom: clamp(48px, 7vw, 104px);
  }

  .section-head--split {
    display: grid;
    gap: 24px 64px;
    align-items: end;
  }

  @media (min-width: 900px) {
    .section-head--split {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }

  .section-title {
    font-size: clamp(2.5rem, 1.6rem + 4.4vw, 6.5rem);
  }

  .section-intro {
    max-width: 44ch;
    color: var(--muted);
  }

  /* Hero */
  .hero {
    padding-block: clamp(40px, 7vw, 120px) clamp(72px, 10vw, 160px);
  }

  .hero__foot {
    display: grid;
    gap: 28px clamp(40px, 6vw, 112px);
    margin-top: clamp(32px, 5vw, 72px);
    padding-top: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--ink);
  }

  .hero__line {
    display: block;
  }

  .hero__title {
    max-width: 18ch;
    font-size: clamp(2.25rem, 1.3rem + 3.6vw, 5.25rem);
    line-height: 0.98;
  }

  .hero__side {
    display: grid;
    gap: 28px;
    align-content: start;
  }

  .hero__lede {
    max-width: 46ch;
    font-size: clamp(1.05rem, 0.95rem + 0.35vw, 1.25rem);
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (min-width: 1000px) {
    .hero__foot {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: start;
    }

    .hero__side {
      padding-top: 0.5em;
    }
  }

  /* The other 99% */
  .ninety-nine {
    padding-top: 0;
  }

  .ninety-nine .wrap {
    padding-top: clamp(80px, 11vw, 168px);
    border-top: 1px solid var(--line);
  }

  .ninety-nine .section-title {
    max-width: 13ch;
  }

  .dots {
    margin: 0;
    justify-self: start;
  }

  .dots__grid {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: clamp(6px, 0.8vw, 10px);
    width: clamp(200px, 26vw, 320px);
    margin-bottom: 16px;
  }

  .dots__dot {
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--line);
  }

  .dots__dot--one {
    background: var(--gold);
    transform: scale(1.25);
  }

  .dots figcaption {
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .dots {
      justify-self: end;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .dots__dot--one {
      transition: transform 0.6s 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.4s 0.6s;
    }

    :global(.reveal-ready) .dots:not(.is-in) .dots__dot--one {
      background: var(--line);
      transform: none;
    }
  }

  .compare {
    border-top: 1px solid var(--ink);
  }

  .compare__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px clamp(24px, 4vw, 64px);
    padding: clamp(16px, 2vw, 24px) 0;
    border-bottom: 1px solid var(--line);
    font-size: clamp(0.95rem, 0.88rem + 0.35vw, 1.3rem);
    line-height: 1.3;
  }

  .compare__row--head {
    font-size: 0.75rem;
    font-weight: 560;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .compare__row--head span:last-child {
    color: var(--ink);
  }

  .compare__them {
    color: var(--muted);
  }

  .compare__us {
    font-weight: 560;
  }

  /* Work */
  .work__list {
    display: grid;
    gap: clamp(72px, 10vw, 152px);
  }

  .work-item {
    display: grid;
    gap: 28px;
  }

  .work-item__media {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    padding: 8%;
    border-radius: 4px;
    background: #f4f4f2;
  }

  .work-item__media > :global(*) {
    transition: transform 0.9s var(--ease-out);
  }

  @media (hover: hover) {
    .work-item:hover .work-item__media > :global(*) {
      transform: scale(1.04);
    }
  }

  .work-item__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-bottom: 20px;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-on-ink);
  }

  .work-item__meta span:first-child {
    color: var(--paper);
    font-variant-numeric: tabular-nums;
  }

  .work-item__title {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 4.5rem);
    margin-bottom: 20px;
  }

  .work-item__teaser {
    max-width: 48ch;
    margin-bottom: 24px;
    color: var(--muted-on-ink);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }

  .tags li {
    padding: 6px 12px;
    border: 1px solid var(--line-on-ink);
    border-radius: 999px;
    font-size: 0.8rem;
  }

  @media (min-width: 900px) {
    .work-item {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(40px, 5vw, 96px);
      align-items: start;
    }

    /* Mirror the layout on every other project, keeping the photo the
       wider column both times. */
    .work-item:nth-child(even) {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .work-item:nth-child(even) .work-item__media {
      order: 2;
    }

    .work-item__body {
      padding-top: clamp(8px, 2vw, 40px);
    }
  }

  /* Services */
  .services__grid {
    display: grid;
    gap: 0 clamp(40px, 5vw, 96px);
  }

  .service {
    padding: 36px 0 48px;
    border-top: 1px solid var(--ink);
  }

  .service__num {
    margin-bottom: 20px;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .service__title {
    font-size: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    margin-bottom: 20px;
  }

  .service__summary {
    max-width: 46ch;
    margin-bottom: 24px;
    color: var(--ink-soft);
  }

  .service__list li {
    display: flex;
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }

  .service__list li::before {
    content: '—';
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* An odd one out at the end takes the full row, with its list beside
       the summary rather than leaving half the row empty. */
    .service:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0 clamp(40px, 5vw, 96px);
      align-items: start;
    }

    .service:last-child:nth-child(odd) .service__list {
      grid-column: 2;
      grid-row: 1 / span 3;
    }
  }

  /* Brand film */
  .motion-film {
    display: grid;
    gap: 28px;
    margin-top: clamp(56px, 7vw, 104px);
    padding-top: clamp(32px, 4vw, 48px);
    border-top: 1px solid var(--ink);
  }

  .motion-film__title {
    margin-bottom: 14px;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 3rem);
  }

  .motion-film__intro {
    max-width: 52ch;
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .motion-film__head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0 clamp(40px, 5vw, 96px);
      align-items: end;
    }

    .motion-film__head .label {
      grid-column: 1 / -1;
    }

    .motion-film__title {
      margin-bottom: 0;
    }
  }

  /* Add-ons */
  .addons {
    display: grid;
    gap: 32px clamp(40px, 5vw, 96px);
    margin-top: clamp(56px, 7vw, 104px);
    padding-top: clamp(32px, 4vw, 48px);
    border-top: 1px solid var(--ink);
  }

  .addons__title {
    margin-bottom: 14px;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 3rem);
  }

  .addons__intro {
    color: var(--muted);
  }

  .addon {
    display: grid;
    gap: 8px 32px;
    padding: 20px 0 22px;
    border-top: 1px solid var(--line);
  }

  .addon:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .addon__title {
    margin: 0;
    font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.5rem);
    line-height: 1.15;
  }

  .addon__summary {
    max-width: 60ch;
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .addons {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: start;
    }

    .addon {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      align-items: baseline;
    }
  }

  /* The one percent */
  .details__grid {
    display: grid;
    gap: 1px;
    background: var(--line-on-ink);
    border-block: 1px solid var(--line-on-ink);
  }

  .detail {
    padding: clamp(28px, 3vw, 44px) clamp(0px, 2vw, 32px) clamp(32px, 3.5vw, 52px);
    background: var(--ink);
  }

  .detail__pct {
    display: inline-block;
    margin-bottom: 28px;
    padding: 3px 7px 2px;
    border: 1px solid var(--gold-bright);
    border-radius: 4px;
    color: var(--gold-bright);
    font-size: 0.75rem;
    font-weight: 640;
    font-variation-settings: 'wdth' 82;
  }

  .detail__title {
    margin-bottom: 14px;
    font-size: clamp(1.5rem, 1.25rem + 0.9vw, 2.1rem);
    line-height: 1.05;
  }

  .detail p {
    max-width: 40ch;
    color: var(--muted-on-ink);
  }

  @media (min-width: 700px) {
    .details__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .detail {
      padding-inline: clamp(20px, 2.5vw, 40px);
    }
  }

  @media (min-width: 1100px) {
    .details__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Process */
  /* Room under the steps for the golden-ratio construction (desktop). */
  @media (min-width: 900px) {
    .process {
      padding-bottom: clamp(260px, 26vw, 400px);
    }
  }

  .process__steps {
    display: grid;
    gap: 0 clamp(24px, 3vw, 48px);
    counter-reset: step;
  }

  .step {
    padding: 28px 0 40px;
    border-top: 1px solid var(--ink);
  }

  .step__num {
    margin-bottom: clamp(24px, 4vw, 64px);
    font-size: clamp(3rem, 2rem + 3vw, 5.5rem);
    font-weight: 300;
    font-variation-settings: 'wdth' 75;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .step__title {
    margin-bottom: 12px;
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
  }

  .step p:last-child {
    color: var(--ink-soft);
  }

  @media (min-width: 700px) {
    .process__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .process__steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Contact */
  .contact__title {
    max-width: 14ch;
    margin-bottom: clamp(48px, 7vw, 104px);
    font-size: clamp(3rem, 1.4rem + 7.4vw, 9.5rem);
    line-height: 0.92;
  }

  .contact__grid {
    display: grid;
    gap: 56px clamp(48px, 7vw, 128px);
    padding-top: 32px;
    border-top: 1px solid var(--paper);
  }

  .contact__lede {
    max-width: 40ch;
    margin-bottom: 28px;
    color: var(--muted-on-ink);
  }

  .contact__alt-label {
    margin-bottom: 8px;
    font-size: 0.75rem;
    font-weight: 560;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-on-ink);
  }

  .contact__email {
    display: inline-block;
