---
// 03 Services: the five services, the coded brand film, and the add-ons.
import InkWord from '../InkWord.astro';
import BrandFilm from '../BrandFilm.astro';
import { services, addons } from '../../data/services';
import { hl, pad } from '../../utils/text';
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <header class="section-head section-head--split">
      <div>
        <p class="label"><span class="label__num">03</span> Services</p>
        <h2 id="services-title" class="section-title" data-reveal>What we <InkWord mark="double">make</InkWord>.</h2>
      </div>
      <p class="section-intro" data-reveal>
        Every project is quoted on its own scope. Tell us what you need and we’ll come back with a clear, fixed price
        before any work starts.
      </p>
    </header>

    <div class="services__grid">
      {services.map((s, i) => (
        <article class="service" data-reveal style={`--reveal-delay: ${(i % 2) * 0.08}s`}>
          <p class="service__num">{pad(i + 1)}</p>
          <h3 class="service__title" set:html={hl(s.title, s.accent)} />
          <p class="service__summary">{s.summary}</p>
          <ul class="service__list">
            {s.includes.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <div class="motion-film">
      <div class="motion-film__head" data-reveal>
        <p class="label">Motion graphics, in motion</p>
        <h3 class="motion-film__title">Our own brand, in <span class="serif">motion</span>.</h3>
        <p class="motion-film__intro">
          A 30-second brand film, coded to run live in your browser, so it’s sharp on any screen. The same piece cuts
          to music for social media.
        </p>
      </div>
      <BrandFilm />
    </div>

    <div class="addons">
      <div class="addons__head" data-reveal>
        <p class="label">Add-ons</p>
        <h3 class="addons__title">Smaller jobs, same <span class="serif">standards</span>.</h3>
        <p class="addons__intro">On their own, or alongside a bigger project.</p>
      </div>
      <ul class="addons__list">
        {addons.map((a) => (
          <li class="addon" data-reveal>
            <h4 class="addon__title">{a.title}</h4>
            <p class="addon__summary">{a.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    gap: 0 clamp(40px, 5vw, 96px);
  }

  .service {
    padding: 36px 0 48px;
    border-top: 1px solid var(--ink);
  }

  .service__num {
    margin-bottom: 20px;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .service__title {
    font-size: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    margin-bottom: 20px;
  }

  .service__summary {
    max-width: 46ch;
    margin-bottom: 24px;
    color: var(--ink-soft);
  }

  .service__list li {
    display: flex;
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }

  .service__list li::before {
    content: '—';
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* An odd one out at the end takes the full row, with its list beside
       the summary rather than leaving half the row empty. */
    .service:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0 clamp(40px, 5vw, 96px);
      align-items: start;
    }

    .service:last-child:nth-child(odd) .service__list {
      grid-column: 2;
      grid-row: 1 / span 3;
    }
  }

  /* Brand film */
  .motion-film {
    display: grid;
    gap: 28px;
    margin-top: clamp(56px, 7vw, 104px);
    padding-top: clamp(32px, 4vw, 48px);
    border-top: 1px solid var(--ink);
  }

  .motion-film__title {
    margin-bottom: 14px;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 3rem);
  }

  .motion-film__intro {
    max-width: 52ch;
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .motion-film__head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0 clamp(40px, 5vw, 96px);
      align-items: end;
    }

    .motion-film__head .label {
      grid-column: 1 / -1;
    }

    .motion-film__title {
      margin-bottom: 0;
    }
  }

  /* Add-ons: a compact list, one short line each. */
  .addons {
    margin-top: clamp(48px, 5vw, 80px);
    padding-top: clamp(28px, 3vw, 40px);
    border-top: 1px solid var(--ink);
  }

  .addons__head {
    display: grid;
    gap: 8px clamp(40px, 5vw, 96px);
    margin-bottom: clamp(20px, 2.5vw, 32px);
  }

  .addons__title {
    margin: 0;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 3rem);
  }

  .addons__intro {
    color: var(--muted);
  }

  .addon {
    display: grid;
    gap: 2px 32px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }

  .addon__title {
    margin: 0;
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem);
    line-height: 1.25;
  }

  .addon__summary {
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .addons__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
    }

    .addons__head .label {
      grid-column: 1 / -1;
    }

    .addon {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: baseline;
    }
  }
</style>
