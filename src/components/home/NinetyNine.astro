---
// 01 The other 99%: the 100-dot grid (one dot remembered), the line-by-line
// comparison, and the "Is your site in the 99%?" quick check.
import InkWord from '../InkWord.astro';
import SiteCheck from '../SiteCheck.astro';

// The other 99% vs the one percent, line for line.
const compare = [
  ['A template thousands of other businesses are using', 'Designed from scratch around your business'],
  ['Stock photos of strangers shaking hands', 'Your real people, places and products'],
  ['Copy that could belong to anyone', 'Words written in your voice'],
  ['Looks dated a year after launch', 'Built to be updated, so it stays fresh'],
  ['Breaks on the screens nobody checked', 'Tested on every screen, phone to TV'],
];
---

<section class="section ninety-nine" aria-labelledby="ninety-nine-title">
  <div class="wrap">
    <header class="section-head section-head--split">
      <div>
        <p class="label"><span class="label__num">01</span> The other 99%</p>
        <h2 id="ninety-nine-title" class="section-title" data-reveal>
          Same template. Same stock photos. Same <InkWord mark="strike">forgettable</InkWord> result.
        </h2>
      </div>
      <figure class="dots" data-reveal aria-hidden="true">
        <div class="dots__grid">
          {Array.from({ length: 100 }, (_, i) => <span class:list={['dots__dot', { 'dots__dot--one': i === 99 }]} />)}
        </div>
        <figcaption>99 look the same. 1 gets remembered.</figcaption>
      </figure>
    </header>

    <div class="compare" role="table" aria-label="The other 99% compared with the one percent">
      <div class="compare__row compare__row--head" role="row">
        <span role="columnheader">The other 99%</span>
        <span role="columnheader">The one percent</span>
      </div>
      {compare.map(([them, us]) => (
        <div class="compare__row" role="row" data-reveal>
          <span class="compare__them" role="cell">{them}</span>
          <span class="compare__us" role="cell">{us}</span>
        </div>
      ))}
    </div>
    <SiteCheck />
  </div>
</section>

<style>
  .ninety-nine {
    padding-top: 0;
  }

  .ninety-nine .wrap {
    padding-top: clamp(80px, 11vw, 168px);
    border-top: 1px solid var(--line);
  }

  .ninety-nine .section-title {
    max-width: 13ch;
  }

  .dots {
    margin: 0;
    justify-self: start;
  }

  .dots__grid {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: clamp(6px, 0.8vw, 10px);
    width: clamp(200px, 26vw, 320px);
    margin-bottom: 16px;
  }

  .dots__dot {
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--line);
  }

  .dots__dot--one {
    background: var(--gold);
    transform: scale(1.25);
  }

  .dots figcaption {
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .dots {
      justify-self: end;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .dots__dot--one {
      transition: transform 0.6s 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.4s 0.6s;
    }

    :global(.reveal-ready) .dots:not(.is-in) .dots__dot--one {
      background: var(--line);
      transform: none;
    }
  }

  .compare {
    border-top: 1px solid var(--ink);
  }

  .compare__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px clamp(24px, 4vw, 64px);
    padding: clamp(16px, 2vw, 24px) 0;
    border-bottom: 1px solid var(--line);
    font-size: clamp(0.95rem, 0.88rem + 0.35vw, 1.3rem);
    line-height: 1.3;
  }

  .compare__row--head {
    font-size: 0.75rem;
    font-weight: 560;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .compare__row--head span:last-child {
    color: var(--ink);
  }

  .compare__them {
    color: var(--muted);
  }

  .compare__us {
    font-weight: 560;
  }
</style>
