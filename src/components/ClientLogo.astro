---
// Client logos for the portfolio, shown in the clients' own colours: the
// only colour on an otherwise black-and-white site, on purpose.
//
// Salt and Sun Tours: the sun-over-water mark plus the uppercase Besley
// wordmark with "Sun" in their ochre, rebuilt from their site's header.
// Springtide Adventure Park: the hand-lettered artwork from their brand files.
import '@fontsource/besley/600.css';
import springtide from '../assets/logos/springtide.svg';

export type LogoId = 'salt-and-sun' | 'springtide';

interface Props {
  id: LogoId;
  label: string;
}
const { id, label } = Astro.props;
---

{id === 'salt-and-sun' && (
  <span class="logo logo--ss" role="img" aria-label={label}>
    <svg class="logo-ss__mark" viewBox="0 0 40 40" aria-hidden="true">
      <defs>
        <clipPath id="ss-mark-clip"><circle cx="20" cy="20" r="19" /></clipPath>
      </defs>
      <g clip-path="url(#ss-mark-clip)">
        <rect x="0" y="0" width="40" height="20" fill="#d1754a" />
        <rect x="1.11" y="22" width="37.79" height="1.3" rx="0.65" fill="#8b6762" />
        <rect x="1.54" y="24.5" width="36.92" height="1.3" rx="0.65" fill="#8b6762" />
        <rect x="2.34" y="27" width="35.33" height="1.3" rx="0.65" fill="#8b6762" />
        <rect x="3.55" y="29.5" width="32.91" height="1.3" rx="0.65" fill="#8b6762" />
        <rect x="5.27" y="32" width="29.46" height="1.3" rx="0.65" fill="#8b6762" />
        <rect x="7.72" y="34.5" width="24.56" height="1.3" rx="0.65" fill="#8b6762" />
        <rect x="11.51" y="37" width="16.97" height="1.3" rx="0.65" fill="#8b6762" />
      </g>
    </svg>
    <span class="logo-ss__text" aria-hidden="true">Salt and <span class="logo-ss__accent">Sun</span> Tours</span>
  </span>
)}

{id === 'springtide' && (
  <img class="logo logo--st" src={springtide.src} width={springtide.width} height={springtide.height} alt={label} loading="lazy" decoding="async" />
)}

<style>
  .logo--ss {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6em;
    font-family: 'Besley', Georgia, 'Times New Roman', serif;
    font-weight: 600;
    font-size: clamp(1rem, 0.6rem + 1.6vw, 1.9rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #3a231c;
  }

  .logo-ss__mark {
    width: 3.4em;
    height: 3.4em;
  }

  .logo-ss__accent {
    color: #c1863a;
  }

  .logo--st {
    width: auto;
    height: 72%;
    max-height: 340px;
  }
</style>
