---
// Home page. Each section lives in src/components/home/ (About is
// home/About.astro). The pen line in src/scripts/ink.ts is drawn around
// these sections, so keep their class names in step with it: it warns in the
// console, and `npm test` fails, if one it relies on goes missing.
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import NinetyNine from '../components/home/NinetyNine.astro';
import Work from '../components/home/Work.astro';
import Services from '../components/home/Services.astro';
import Details from '../components/home/Details.astro';
import Process from '../components/home/Process.astro';
import About from '../components/home/About.astro';
import Contact from '../components/home/Contact.astro';
---

<Base>
  <Hero />
  <NinetyNine />
  <Work />
  <Services />
  <Details />
  <Process />
  <About />
  <Contact />
</Base>
