---
// "Is your site in the 99%?" — six yes/no questions under the 99% comparison.
// The result places "your site" in the same 100-dot grid as the rest of the
// page: all six "yes" makes it the one gold dot. The button pre-selects a
// service in the enquiry form (data-prefill) and jumps to Contact.
import { checkQuestions, checkResults } from '../data/enquiry';

const spots = [12, 30, 48, 66, 82, 94, 99];
---

<div class="check" data-check data-results={JSON.stringify(checkResults)} data-spots={JSON.stringify(spots)}>
  <div class="check__head">
    <p class="label">Quick check</p>
    <h3 class="check__title">Is your site in the <span class="serif">99%</span>?</h3>
    <p class="check__intro">Six honest answers about your current website. It takes 20 seconds and nothing is sent anywhere.</p>
  </div>

  <ol class="check__questions">
    {checkQuestions.map((q, i) => (
      <li>
        <fieldset class="q">
          <legend class="q__text"><span class="q__num">{String(i + 1).padStart(2, '0')}</span>{q}</legend>
          <div class="q__answers">
            <label class="q__opt">
              <input type="radio" name={`check-${i}`} value="yes" id={`check-${i}-yes`} />
              <span>Yes</span>
            </label>
            <label class="q__opt">
              <input type="radio" name={`check-${i}`} value="no" id={`check-${i}-no`} />
              <span>No</span>
            </label>
          </div>
        </fieldset>
      </li>
    ))}
  </ol>

  <div class="result" aria-live="polite">
    <div class="result__grid" aria-hidden="true">
      {Array.from({ length: 100 }, (_, i) => <span class="result__dot" data-dot={i} />)}
    </div>
    <div class="result__text">
      <p class="result__score" data-score>0 of 6 answered</p>
      <p class="result__title" data-title>Answer all six to see where your site sits.</p>
      <p class="result__body" data-body></p>
      <a class="btn btn--ghost" href="#contact" data-cta data-prefill="audit" hidden>
        <span data-cta-label>Get a 1% Audit</span> <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>

<script>
  type Result = { min: number; title: string; body: string; cta: string; prefill: string };
  const root = document.querySelector<HTMLElement>('[data-check]');
  if (root) {
    const results: Result[] = JSON.parse(root.dataset.results ?? '[]');
    const spots: number[] = JSON.parse(root.dataset.spots ?? '[]');
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const scoreEl = root.querySelector<HTMLElement>('[data-score]')!;
    const titleEl = root.querySelector<HTMLElement>('[data-title]')!;
    const bodyEl = root.querySelector<HTMLElement>('[data-body]')!;
    const cta = root.querySelector<HTMLAnchorElement>('[data-cta]')!;
    const ctaLabel = root.querySelector<HTMLElement>('[data-cta-label]')!;
    const total = root.querySelectorAll('fieldset').length;

    const update = () => {
      const picked = [...root.querySelectorAll<HTMLInputElement>('input[type=radio]:checked')];
      const yes = picked.filter((p) => p.value === 'yes').length;
      dots.forEach((d) => d.classList.remove('is-you', 'is-one'));
      if (picked.length < total) {
        scoreEl.textContent = `${picked.length} of ${total} answered`;
        return;
      }
      const r = results.find((x) => yes >= x.min) ?? results[results.length - 1];
      scoreEl.textContent = `${yes} of ${total}`;
      titleEl.textContent = r.title;
      bodyEl.textContent = r.body;
      ctaLabel.textContent = r.cta;
      cta.dataset.prefill = r.prefill;
      cta.hidden = false;
      const spot = dots[spots[yes] ?? 0];
      spot.classList.add(yes === total ? 'is-one' : 'is-you');
      root.classList.add('is-done');
    };
    root.addEventListener('change', update);
  }
</script>

<style>
  .check {
    display: grid;
    gap: 32px clamp(40px, 6vw, 112px);
    margin-top: clamp(64px, 8vw, 120px);
    padding-top: clamp(32px, 4vw, 48px);
    border-top: 1px solid var(--ink);
  }

  .check__title {
    margin-bottom: 14px;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 3rem);
  }

  .check__intro {
    max-width: 44ch;
    color: var(--ink-soft);
  }

  .check__questions {
    display: grid;
    min-width: 0;
  }

  .check__questions li + li {
    border-top: 1px solid var(--line);
  }

  .q {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin: 0;
    padding: 16px 0;
    border: 0;
    min-width: 0;
  }

  .q__text {
    display: flex;
    gap: 14px;
    float: left;
    max-width: 44ch;
    padding: 0;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.15rem);
    line-height: 1.35;
  }

  .q__num {
    font-size: 0.8rem;
    padding-top: 0.2em;
    font-variant-numeric: tabular-nums;
    color: var(--gold-text);
    font-weight: 640;
  }

  .q__answers {
    display: inline-flex;
    border: 1px solid var(--ink);
    border-radius: 999px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .q__opt {
    position: relative;
    cursor: pointer;
  }

  .q__opt input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .q__opt span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 64px;
    min-height: 40px;
    padding: 0 16px;
    font-size: 0.92rem;
    font-weight: 560;
    transition:
      background-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }

  .q__opt + .q__opt span {
    border-left: 1px solid var(--ink);
  }

  .q__opt input:checked + span {
    background: var(--ink);
    color: var(--paper);
  }

  .q__opt input:focus-visible + span {
    outline: 2px solid var(--gold);
    outline-offset: -4px;
  }

  .result {
    display: grid;
    gap: 24px;
    align-content: start;
  }

  .result__grid {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: clamp(5px, 0.6vw, 8px);
    width: min(100%, 260px);
  }

  .result__dot {
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--line);
    transition:
      background-color 0.4s var(--ease-out),
      transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.4s var(--ease-out);
  }

  .result__dot.is-you {
    background: var(--ink);
    transform: scale(1.35);
    box-shadow: 0 0 0 3px var(--paper), 0 0 0 4px var(--ink);
  }

  .result__dot.is-one {
    background: var(--gold);
    transform: scale(1.45);
    box-shadow: 0 0 0 3px var(--paper), 0 0 0 4px var(--gold);
  }

  .result__score {
    margin-bottom: 6px;
    font-size: 0.8rem;
    font-weight: 560;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .result__title {
    margin-bottom: 8px;
    font-size: clamp(1.4rem, 1.15rem + 0.9vw, 2rem);
    font-weight: 640;
    font-variation-settings: 'wdth' 82;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .result__body {
    max-width: 40ch;
    margin-bottom: 20px;
    color: var(--ink-soft);
  }

  .result__body:empty {
    display: none;
  }

  @media (min-width: 1000px) {
    .check {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: start;
    }

    .check__head {
      grid-column: 1 / -1;
    }

    .result {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }
</style>
